-- Doc-example corpus: every copy-pasteable ROSQL query from user-facing documentation.
--
-- Rules:
--   (a) Every ROSQL query added to any documentation surface must appear here.
--   (b) If a query is removed from docs, remove it here too.
--   (c) Queries that return ROSQLError::NotImplemented are acceptable (gated clauses);
--       these are marked with -- [GATED] below: HEALTH(), CORRELATE, SHOW RECORDING.
--   (d) DURING combined form (FROM ... DURING(...)) silently drops the DURING clause
--       (not yet wired in the standard-query parser); the smoke test passes but does
--       not verify DURING is applied.
--
-- Tested by: tests/doc_queries.rs (parse + compile for PostgreSQL and DuckDB).

-- ── README ──────────────────────────────────────────────────────────────────

SELECT trace_id, span_name, service_name, duration, status_code, span_attributes FROM traces WHERE status = 'ERROR' AND action_name = '/navigate_to_pose' DURING( FROM topics WHERE topic_name = '/battery_state' AND fields['percentage'] < 15 ) SINCE 6 hours ago

TRACE 'a3f1c9d2e8b04f7a'

SELECT span_name, duration FROM traces WHERE action_name = '/navigate_to_pose' AND duration > 500 ms SINCE 1 hour ago ORDER BY duration DESC LIMIT 20

FROM traces WHERE status = 'ERROR' DURING( FROM topics WHERE topic_name = '/battery_state' AND fields['percentage'] < 20 ) SINCE yesterday

SELECT COUNT(*) AS errors FROM traces WHERE status = 'ERROR' TIMESERIES 5 min SINCE 1 hour ago FACET robot_id

SELECT * FROM traces WHERE status = 'ERROR' AND action_name = '/navigate_to_pose' SINCE 1 hour ago ENRICH WITH logs LIMIT 20

