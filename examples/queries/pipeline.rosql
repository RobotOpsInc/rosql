-- Pipeline syntax — chain stages with | for readable query composition

-- Find slow error spans, grouped by robot
FROM traces
| WHERE duration > 500 ms
| WHERE status = 'ERROR'
| FACET robot_id

-- Navigation failures with baseline comparison
FROM traces
| WHERE action_name = '/navigate_to_pose'
| WHERE status = 'ERROR'
| FACET robot_id
| COMPARE TO last week

-- Log analysis pipeline
FROM logs
| WHERE severity IN ('ERROR', 'WARN')
| ORDER BY severity DESC
| LIMIT 20
