-- Compound clause queries — the killer demos
-- These showcase ROSQL's unique robotics-native features.

-- ============================================================================
-- Which navigation action failed?
-- ============================================================================
FROM traces WHERE status = 'ERROR' AND action_name = '/navigate_to_pose'

-- ============================================================================
-- TRACE — recursive span tree walk for the full causality chain
-- Follows ParentSpanId links to show how a message propagated through nodes.
-- ============================================================================
TRACE 'trace-002'

-- ============================================================================
-- MESSAGE FLOW — find all message paths for /cmd_vel
-- Shows which nodes published and subscribed to velocity commands.
-- ============================================================================
MESSAGE FLOW FROM TOPIC '/cmd_vel'

-- ============================================================================
-- MESSAGE FLOW TO NODE — trace messages from a topic to a specific node
-- ============================================================================
MESSAGE FLOW FROM TOPIC '/cmd_vel' TO NODE '/controller_server'

-- ============================================================================
-- HEALTH() — derived robot health assessment
-- Fan-out across traces, logs, and metrics to get an overall health picture.
-- ============================================================================
HEALTH() FOR ROBOT 'robot_sim_001'

-- ============================================================================
-- PATH DEVIATION — did the robot deviate from its planned path?
-- Queries /odom trajectory data from topic_messages.
-- ============================================================================
PATH DEVIATION FOR ROBOT 'robot_sim_001'

-- ============================================================================
-- SHOW RECORDING — find the MCAP recording that covers the failure window
-- ============================================================================
SHOW RECORDING

-- ============================================================================
-- ANOMALY — detect statistical anomalies in span duration
-- Uses z-score (AVG/STDDEV) to find outlier spans.
-- ============================================================================
ANOMALY(duration)

-- ============================================================================
-- SHOW DEPLOYMENTS — deployment history (version × environment)
-- ============================================================================
SHOW DEPLOYMENTS FOR ROBOT 'robot_sim_001' SINCE 30 days ago

-- ============================================================================
-- SHOW SPAN SUMMARY — top spans by average duration
-- ============================================================================
SHOW SPAN SUMMARY FOR ROBOT 'robot_sim_001' SINCE 1 hour ago

-- ============================================================================
-- SHOW PLANS — navigation/behaviour plan spans for a trace
-- ============================================================================
SHOW PLANS FOR TRACE 'trace-002'

-- ============================================================================
-- SHOW TOPICS — list active ROS2 topics with publish rates (v0.4.2+)
-- Aggregates span_attributes to show topic_name, message_type, avg_rate_hz,
-- publisher/subscriber counts, and last_message_age_ms.
-- ============================================================================
SHOW TOPICS FOR ROBOT 'robot_sim_001' SINCE 1 hour ago
SHOW TOPICS WHERE topic_name LIKE '/camera%' SINCE 30 minutes ago

-- ============================================================================
-- SHOW NODES — list active ROS2 nodes with pub/sub counts (v0.4.2+)
-- ============================================================================
SHOW NODES FOR ROBOT 'robot_sim_001' SINCE 30 minutes ago

-- ============================================================================
-- SHOW NODE GRAPH — topic/node edges for graph visualisation (v0.4.2+)
-- Returns (source_node, topic, target_node) rows for building a network graph.
-- ============================================================================
SHOW NODE GRAPH FOR ROBOT 'robot_sim_001' SINCE 30 minutes ago
